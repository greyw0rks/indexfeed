# IndexFeed configuration. Copy to .env and fill in.
# Never commit .env — the publisher key is the only key that can write the index.

# --- Network ---
# testnet | pubnet. pubnet has no public RPC, so STELLAR_RPC_URL is mandatory there.
STELLAR_NETWORK=testnet
# STELLAR_RPC_URL=https://your-provider.example.com

# --- Oracle contract ---
ORACLE_CONTRACT_ID=

# --- Aggregator (publishing side) ---
# Write access to the contract. Server-side only; never ship to a client.
PUBLISHER_SECRET_KEY=
# Can rotate the publisher key. Keep offline / in a separate custody path.
ADMIN_PUBLIC_KEY=
# Where basket units, divisor, and per-epoch audit records are kept. Losing this
# means the next rebalance cannot reproduce the divisor.
STATE_DIR=./state
# Set to 1 to use deterministic fixture prices instead of live venues.
# Offline development only — never enable in production.
USE_FIXTURE_PRICES=0

# --- API (serving side) ---
PORT=3001
# Any funded account. Used only as the source for read simulations; signs nothing.
READ_SOURCE_ACCOUNT=
# Where x402 payments land. Needs a USDC trustline before it can be paid.
X402_PAY_TO=
X402_FACILITATOR_URL=https://www.x402.org/facilitator
PRICE_LATEST=$0.01
PRICE_VALUE=$0.005
PRICE_HISTORY=$0.02
CACHE_TTL_SECONDS=15

# --- Reference client ---
INDEXFEED_API_URL=http://localhost:3001
# Paying wallet. Needs USDC and a USDC trustline.
CLIENT_SECRET_KEY=
MAX_PRICE_PER_REQUEST=$0.05
